# TaskFlow - Environment Variables

# Database
ConnectionStrings__DefaultConnection=Server=localhost;Port=5432;Database=taskflow;User=taskflow_user;Password=your_secure_password;

# JWT Settings
JwtSettings__SecretKey=your_jwt_secret_key_must_be_at_least_32_characters_long
JwtSettings__Issuer=TaskFlow
JwtSettings__Audience=TaskFlow
JwtSettings__ExpirationInMinutes=60

# Application
ASPNETCORE_ENVIRONMENT=Development