# MySQL 8.0+
MYSQL_DATABASE=TaskFlowDb
MYSQL_USER=taskflow
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_PORT=3307

# API (ASP.NET Core configuration environment variables)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3307;Database=TaskFlowDb;User ID=taskflow;Password=replace-with-a-long-random-password;
Cors__AllowedOrigins__0=http://localhost:5173
DataProtection__KeyPath=.keys
ASPNETCORE_ENVIRONMENT=Development
